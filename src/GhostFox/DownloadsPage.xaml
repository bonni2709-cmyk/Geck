<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GhostFox.DownloadsPage"
             Title="Downloads"
             BackgroundColor="{DynamicResource GfBackground}">
    <Grid RowDefinitions="*,Auto">
        <CollectionView x:Name="DownloadsView" Margin="16">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Padding="8">
                        <Label Text="{Binding FileName}" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="⏸ Pause" CommandParameter="{Binding Id}" Clicked="OnPauseClicked" />
                        <Label Grid.Row="1" Text="{Binding StatusText}" FontSize="12" TextColor="{DynamicResource GfTextDim}" />
                        <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Progress="{Binding Progress}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="1" Text="Close" Margin="16" Clicked="OnCloseClicked" />
    </Grid>
</ContentPage>
