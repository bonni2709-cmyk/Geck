<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GhostFox.LibraryPage"
             Title="Library"
             BackgroundColor="{DynamicResource GfBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="★ Bookmarks" FontSize="17" FontAttributes="Bold" />
            <CollectionView x:Name="BookmarksView" SelectionMode="Single" SelectionChanged="OnItemSelected" HeightRequest="260">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Padding="6">
                            <VerticalStackLayout>
                                <Label Text="{Binding Title}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Url}" FontSize="11" TextColor="{DynamicResource GfTextDim}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="✕" CommandParameter="{Binding Url}" Clicked="OnDeleteBookmarkClicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="🕘 History" FontSize="17" FontAttributes="Bold" />
            <Button Text="Clear history" Clicked="OnClearHistoryClicked" />
            <CollectionView x:Name="HistoryView" SelectionMode="Single" SelectionChanged="OnItemSelected" HeightRequest="320">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="6">
                            <Label Text="{Binding Title}" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Url}" FontSize="11" TextColor="{DynamicResource GfTextDim}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Close" Clicked="OnCloseClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
