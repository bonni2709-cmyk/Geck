<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GhostFox.MainPage"
             Title="GhostFox"
             BackgroundColor="{DynamicResource GfBackground}">

    <!-- Корень: [вертикальные вкладки | основная колонка] -->
    <Grid ColumnDefinitions="230,*">

        <!-- ===== МОДУЛЬ 3: вертикальные вкладки ===== -->
        <VerticalStackLayout Grid.Column="0" BackgroundColor="{DynamicResource GfSurface}" Padding="8" Spacing="6">
            <Label Text="🦊 GHOSTFOX" FontAttributes="Bold" FontSize="16" />
            <Label x:Name="EngineLabel" Text="engine: …" FontSize="10" TextColor="{DynamicResource GfTextDim}" />
            <Button Text="+ New Tab" Clicked="OnNewTabClicked" />
            <CollectionView x:Name="TabsView" SelectionMode="Single" SelectionChanged="OnTabSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Padding="8,6">
                            <Label Text="{Binding DisplayTitle}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="✕" FontSize="10" Padding="6,2"
                                    CommandParameter="{Binding Id}" Clicked="OnCloseTabClicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- ===== Основная колонка ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">

            <!-- Тулбар навигации -->
            <HorizontalStackLayout Grid.Row="0" Padding="8" Spacing="6" BackgroundColor="{DynamicResource GfSurface}">
                <Button x:Name="BackButton" Text="←" Clicked="OnBackClicked" />
                <Button x:Name="ForwardButton" Text="→" Clicked="OnForwardClicked" />
                <Button Text="⟳" Clicked="OnReloadClicked" />
                <Button Text="⌂" Clicked="OnHomeClicked" />
                <Entry x:Name="AddressBar" Placeholder="Search or enter address" HorizontalOptions="FillAndExpand"
                       MinimumWidthRequest="420" Completed="OnAddressCompleted" />
                <Button Text="Go" Clicked="OnGoClicked" />
                <Button Text="★" Clicked="OnBookmarkClicked" />
                <Button Text="☰" Clicked="OnMenuClicked" />
            </HorizontalStackLayout>

            <!-- Прогресс загрузки -->
            <ProgressBar x:Name="LoadProgress" Grid.Row="1" Progress="0" ProgressColor="{DynamicResource GfAccent}"
                         HeightRequest="3" IsVisible="False" />

            <!-- Хост движка: сюда платформа встраивает нативный контрол (Windows: GeckoWebBrowser через HWND). -->
            <Grid Grid.Row="2" x:Name="EngineHost" BackgroundColor="#000000">
                <GraphicsView x:Name="GesturePad" IsVisible="False" BackgroundColor="Transparent">
                    <GraphicsView.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnGesturePan" />
                    </GraphicsView.GestureRecognizers>
                </GraphicsView>
                <Grid x:Name="PipHost" IsVisible="False" WidthRequest="360" HeightRequest="235"
                      HorizontalOptions="End" VerticalOptions="End" Margin="14"
                      BackgroundColor="{DynamicResource GfSurface}" RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Padding="6,2">
                        <Label Text="📺 PiP" FontSize="12" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" FontSize="11" Padding="6,2" Clicked="OnPipCloseClicked" />
                    </Grid>
                    <Grid x:Name="PipEngineHost" Grid.Row="1" BackgroundColor="#000000" />
                </Grid>
                <Label x:Name="PlaceholderLabel" IsVisible="False" Margin="24" FontSize="14"
                       Text="Gecko runtime (папка Firefox64) не найден рядом с exe — работает PlaceholderEngine. Положите рантайм Firefox 60 ESR x64 в папку приложения (CI делает это автоматически) и перезапустите GhostFox." />
            </Grid>

            <!-- Статус-бар -->
            <HorizontalStackLayout Grid.Row="3" Padding="8,4" Spacing="12" BackgroundColor="{DynamicResource GfSurface}">
                <Label x:Name="StatusLabel" Text="Ready" FontSize="11" TextColor="{DynamicResource GfTextDim}" />
                <Label x:Name="BlockedLabel" Text="" FontSize="11" TextColor="{DynamicResource GfAccent}" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
