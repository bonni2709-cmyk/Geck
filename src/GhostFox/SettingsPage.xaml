<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GhostFox.SettingsPage"
             Title="Settings"
             BackgroundColor="{DynamicResource GfBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Privacy" FontSize="18" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10"><Switch x:Name="BlockTrackersSwitch" /><Label Text="Block trackers &amp; ads (filter lists)" VerticalOptions="Center" /></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10"><Switch x:Name="CosmeticSwitch" /><Label Text="Cosmetic filters (hide ad blocks via CSS)" VerticalOptions="Center" /></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10"><Switch x:Name="JavaScriptSwitch" /><Label Text="Enable JavaScript" VerticalOptions="Center" /></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10"><Switch x:Name="CookiesSwitch" /><Label Text="Accept cookies" VerticalOptions="Center" /></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10"><Switch x:Name="WebRtcSwitch" /><Label Text="Disable WebRTC (IP leak protection)" VerticalOptions="Center" /></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10"><Switch x:Name="FingerprintSwitch" /><Label Text="Resist fingerprinting (+ Canvas noise)" VerticalOptions="Center" /></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10"><Switch x:Name="ClearOnExitSwitch" /><Label Text="Clear history/session on exit" VerticalOptions="Center" /></HorizontalStackLayout>

            <Label Text="Filter lists" FontSize="18" FontAttributes="Bold" />
            <Label x:Name="FilterStatusLabel" Text="…" FontSize="12" TextColor="{DynamicResource GfTextDim}" />
            <Button x:Name="UpdateFiltersButton" Text="Update filter lists now" Clicked="OnUpdateFiltersClicked" />

            <Label Text="Appearance" FontSize="18" FontAttributes="Bold" />
            <Label Text="Theme" />
            <Picker x:Name="ThemePicker" />
            <Label Text="Accent color (hex, e.g. #FF4081)" />
            <Entry x:Name="AccentEntry" />

            <Label Text="Search" FontSize="18" FontAttributes="Bold" />
            <Label Text="Default search engine" />
            <Picker x:Name="SearchPicker" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="+ Add search engine" Clicked="OnAddSearchEngineClicked" />
                <Button Text="Remove selected" Clicked="OnRemoveSearchEngineClicked" />
            </HorizontalStackLayout>

            <Label Text="General" FontSize="18" FontAttributes="Bold" />
            <Label Text="Home page" />
            <Entry x:Name="HomePageEntry" />
            <Label Text="User-Agent" />
            <Entry x:Name="UserAgentEntry" />
            <Label Text="Custom CSS (injected into every page)" />
            <Editor x:Name="CustomCssEditor" HeightRequest="90" AutoSize="TextChanges" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="+ Add per-site CSS rule" Clicked="OnAddSiteCssClicked" />
                <Button Text="Clear site rules" Clicked="OnClearSiteCssClicked" />
            </HorizontalStackLayout>
            <Label x:Name="SiteCssLabel" Text="" FontSize="12" TextColor="{DynamicResource GfTextDim}" />

            <Button Text="Save" Clicked="OnSaveClicked" />
            <Button Text="Close" Clicked="OnCloseClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
